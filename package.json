{
  "name": "vs-md",
  "displayName": "vs-md",
  "description": "在VScode中输入markdown转换为公众号文档",
  "publisher": "zxy",
  "icon": "resources/md/assets/images/logo.png",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.showLocalWebview",
        "title": "打开微信Markdown编辑器(本地版)",
        "icon": "$(home)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.showLocalWebview",
          "group": "navigation",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/title": [
        {
          "command": "extension.showLocalWebview",
          "group": "navigation",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.showLocalWebview",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {},
    "views": {}
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.91.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "resolutions": {
    "punycode": "^2.3.1"
  }
}
